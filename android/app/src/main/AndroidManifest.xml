<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:largeHeap="true">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->
    <!-- Internet — required for the WebView to load driver.rajlo.com / vercel URL -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location: fine + coarse for the GPS fix itself, background so the
         foreground service keeps streaming once the driver locks the
         screen. The background-geolocation plugin uses these — without
         them the plugin silently degrades to foreground-only tracking. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service: Android 14+ requires apps using location in
         the background to declare a typed foreground service so users
         can see which apps are tracking them at any moment. The
         background-geolocation plugin runs its service under this type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications: Android 13+ requires explicit opt-in to show any
         notification, including the foreground-service sticky one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock: keeps the CPU running long enough to deliver a GPS
         fix when the screen is off. Required for reliable background
         tracking on aggressive battery-saving OEMs (Xiaomi, Huawei). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Microphone: voice notes in the chat (MediaRecorder + getUserMedia).
         Without RECORD_AUDIO declared, the WebView's getUserMedia call
         silently fails — the OS never shows the permission dialog. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera: in-app photo capture for chat attachments (`<input
         type="file" capture="environment">` triggers the system camera). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Photo gallery: Android 13+ split the old READ_EXTERNAL_STORAGE
         into per-type media permissions. We only need image access for
         chat attachments. Older Android falls back to the legacy
         storage permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Hardware features: Android implicitly marks camera + microphone
         as REQUIRED because the CAMERA / RECORD_AUDIO permissions are
         declared above. That silently excludes every device without
         that hardware from the Play Store listing. Camera (chat photo
         attachments) and microphone (chat voice notes) are optional
         conveniences — the driver app's core flow (GPS streaming, ride
         management) works fine without them. Declaring them explicitly
         as not-required overrides the implicit exclusion. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
