<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:largeHeap="true">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Full-screen incoming-call UI for self-managed Telecom calls.
             Telecom does NOT render a system call UI for PROPERTY_SELF_MANAGED
             connections — the app must draw its own. RajloCallConnection
             launches this activity from onShowIncomingCallUi.
             - showWhenLocked + turnScreenOn (set programmatically) make
               it appear over the lockscreen and wake the device.
             - noHistory + excludeFromRecents keep it out of the recents
               list after the call ends.
             - launchMode=singleInstance prevents stacking duplicate
               ringer screens when multiple FCM pushes race in. -->
        <activity
            android:name=".callkit.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- ConnectionService — the Android Telecom integration point.
             The BIND_TELECOM_CONNECTION_SERVICE permission is a
             signature-level permission granted automatically when the
             OS binds to our service. android:exported is true so the
             OS Telecom framework (a separate process) can reach it. -->
        <service
            android:name=".callkit.RajloConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true"
            android:foregroundServiceType="phoneCall">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Intercept FCM pushes BEFORE Capacitor sees them. Required so
             we can call TelecomManager.addNewIncomingCall directly when
             a call push arrives — the JS-driven path doesn't fire when
             the app is backgrounded / killed, but a native FCM service
             runs regardless of WebView state. Non-call pushes fall
             through to super (Capacitor's MessagingService base class)
             so chat / trip / ride notifications keep working unchanged. -->
        <service
            android:name=".callkit.RajloMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Remove Capacitor's auto-merged MessagingService — our own
             service above extends it and handles the same intent filter,
             so we'd otherwise have two services racing for FCM messages.
             Manifest-merger removes the duplicate cleanly with this tag. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
    </application>

    <!-- Permissions -->
    <!-- Internet — required for the WebView to load driver.rajlo.com / vercel URL -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location: fine + coarse for the GPS fix itself, background so the
         foreground service keeps streaming once the driver locks the
         screen. The background-geolocation plugin uses these — without
         them the plugin silently degrades to foreground-only tracking. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service: Android 14+ requires apps using location in
         the background to declare a typed foreground service so users
         can see which apps are tracking them at any moment. The
         background-geolocation plugin runs its service under this type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 14+ requires every typed foreground service to declare
         its type in BOTH the manifest (on the <service> tag) AND a
         matching permission here. phoneCall covers the ConnectionService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!-- Notifications: Android 13+ requires explicit opt-in to show any
         notification, including the foreground-service sticky one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock: keeps the CPU running long enough to deliver a GPS
         fix when the screen is off. Required for reliable background
         tracking on aggressive battery-saving OEMs (Xiaomi, Huawei). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Microphone: voice notes in the chat (MediaRecorder + getUserMedia).
         Without RECORD_AUDIO declared, the WebView's getUserMedia call
         silently fails — the OS never shows the permission dialog. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Telecom integration: lets Rajlo register a self-managed
         PhoneAccount so incoming voice calls (LiveKit) show up on
         the lockscreen and in the system call UI like a native
         phone call. Together with the BIND_TELECOM_CONNECTION_SERVICE
         permission on the service tag below, this routes the
         "incoming call" through the OS Telecom framework. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- Camera: in-app photo capture for chat attachments (`<input
         type="file" capture="environment">` triggers the system camera). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- No READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE: Rajlo only picks a
         photo occasionally (chat attachments, verification-document
         uploads), which is one-time/infrequent access. Google Play's
         Photo and Video Permissions policy reserves those permissions
         for apps whose core purpose is broad photo-library access.
         The WebView's `<input type="file">` chooser delegates to the
         Android system photo picker, which needs no permission — so
         photo selection keeps working without them. -->

    <!-- Hardware features: Android implicitly marks camera + microphone
         as REQUIRED because the CAMERA / RECORD_AUDIO permissions are
         declared above. That silently excludes every device without
         that hardware from the Play Store listing. Camera (chat photo
         attachments) and microphone (chat voice notes) are optional
         conveniences — the driver app's core flow (GPS streaming, ride
         management) works fine without them. Declaring them explicitly
         as not-required overrides the implicit exclusion. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
